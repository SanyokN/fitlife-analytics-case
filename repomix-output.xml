    "def calculate_unit_economics(\n",
    "    ua: int, \n",
    "    cr1: float, \n",
    "    aov: float, \n",
    "    lifespan_months: float, \n",
    "    ad_budget: float, \n",
    "    gross_margin: float = 1.0\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Calculates key Unit Economics metrics for subscription business model.\n",
    "    \"\"\"\n",
    "    buyers = round(ua * cr1)\n",
    "    \n",
    "    # LTV = AOV * Lifespan * Gross Margin\n",
    "    ltv_raw = aov * lifespan_months * gross_margin\n",
    "    \n",
    "    # CAC = Ad Budget / Total Buyers\n",
    "    cac_raw = ad_budget / buyers if buyers > 0 else 0\n",
    "    \n",
    "    # LTV / CAC Ratio\n",
    "    ltv_to_cac_raw = ltv_raw / cac_raw if cac_raw > 0 else 0\n",
    "    \n",
    "    # Unit ROMI = ((LTV - CAC) / CAC) * 100\n",
    "    romi_raw = ((ltv_raw - cac_raw) / cac_raw) * 100 if cac_raw > 0 else 0\n",
    "    \n",
    "    # Total Financials\n",
    "    total_revenue_raw = buyers * ltv_raw\n",
    "    net_profit_raw = total_revenue_raw - ad_budget\n",
    "\n",
    "    return {\n",
    "        \"Acquired Users (UA)\": ua,\n",
    "        \"Paying Customers\": buyers,\n",
    "        \"AOV ($)\": aov,\n",
    "        \"Lifespan (Months)\": lifespan_months,\n",
    "        \"LTV ($)\": round(ltv_raw, 2),\n",
    "        \"CAC ($)\": round(cac_raw, 2),\n",
    "        \"LTV / CAC Ratio\": f\"{round(ltv_to_cac_raw, 2)}x\",\n",
    "        \"Unit ROMI (%)\": f\"{round(romi_raw, 1)}%\",\n",
    "        \"Total Revenue ($)\": round(total_revenue_raw, 2),\n",
    "        \"Net Profit ($)\": round(net_profit_raw, 2)\n",
    "    }\n",
    "\n",
    "# --- Baseline Business Performance (Pre-Experiment) ---\n",
    "params = {\n",
    "    \"ua\": 100000,\n",
    "    \"cr1\": 0.015,          # 1.5% trial-to-paid conversion\n",
    "    \"aov\": 9.99,           # Monthly subscription price\n",
    "    \"lifespan_months\": 4.2,# Average user lifespan in months\n",
    "    \"ad_budget\": 45000,    # Total marketing spend\n",
    "    \"gross_margin\": 1.0    # Assumed 100% gross margin\n",
    "}\n",
    "\n",
    "metrics = calculate_unit_economics(**params)\n",
    "\n",
    "# Display results in structured DataFrame\n",
    "df_results = pd.DataFrame(list(metrics.items()), columns=[\"Metric\", \"Value\"])\n",
    "print(\"=== Baseline Unit Economics Model ===\")\n",
    "print(df_results.to_string(index=False))"
   ]
  }
 ],
